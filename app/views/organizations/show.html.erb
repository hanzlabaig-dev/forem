<% title sanitize(@organization.name) %>

<%= content_for :page_meta do %>
  <%= render "users/meta" %>
  <% unless @stories.sum(&:score).positive? %>
      <meta name="robots" content="noindex">
      <meta name="robots" content="nofollow">
  <% end %>
<% end %>
<%= render "organizations/header" %>
<div
  class="crayons-layout crayons-layout--limited-l crayons-layout--2-cols crayons-layout--2-cols--1-2 pt-4 m:pt-0"
  id="index-container"
  style="<%= org_brand_style(@user) %>"
  data-params="<%= params.merge(sort_by: "published_at", sort_direction: "desc", organization_id: @organization.id).to_json(only: %i[tag organization_id username q sort_by sort_direction]) %>" data-which="<%= @list_of %>"
  data-feed="<%= params[:timeframe] || "base-feed" %>"
  data-articles-since="<%= Timeframe.datetime_iso8601(params[:timeframe]) %>">

  <div class="crayons-layout__sidebar-left crayons-layout__content">
    <%= render "organizations/sidebar" %>
  </div>

   <main class="crayons-layout__content articles-list" id="articles-list">
    <div class="substories" id="substories">
      <% if @organization_pinned_stories.present? %>
        <section class="mb-4" aria-labelledby="organization-pinned-heading">
          <h2 class="crayons-subtitle-2 mb-3" id="organization-pinned-heading"><%= t("views.pins.organization_featured_heading") %></h2>
          <%= render partial: "articles/single_story", collection: @organization_pinned_stories, as: :story, locals: { featured: false } %>
          <% if user_signed_in? && current_user.org_admin?(@organization) %>
            <div class="crayons-card p-3 mt-2">
              <h3 class="crayons-subtitle-2 mb-2"><%= t("views.pins.organization_manage_heading") %></h3>
              <% @organization_pinned_stories.each do |story| %>
                <div class="flex items-center justify-between gap-2 py-2">
                  <span><%= story.title %></span>
                  <%= button_to t("views.pins.organization_unpin_action"),
                                organization_profile_pin_path(slug: @organization.slug, id: @organization.profile_pins.find_by(pinnable_id: story.id).id),
                                method: :delete, class: "crayons-btn crayons-btn--secondary" %>
                </div>
              <% end %>
            </div>
          <% end %>
        </section>
      <% end %>
      <%# organizations/main_feed will iterate on stories with .each_with_index,
          thus by using .present? here we preload the items %>
      <% if @stories.present? %>
        <%= render "organizations/main_feed" %>
      <% end %>
    </div>
    <div class="loading-articles" id="loading-articles">
      <%= t("core.loading") %>
    </div>
  </main>
</div>

<%= javascript_include_tag "storiesList", "localizeArticleDates", defer: true %>
